# Copy this file to .env.local and fill in the values there.
# .env.local is git-ignored. Never commit real values, never paste secrets into chat.

# Supabase > Project Settings > API Keys > "Project URL" (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API Keys > "publishable" key, older name "anon public" (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Supabase > Project Settings > API Keys > "secret" key, older name "service_role" (SECRET: server only)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Console > API Keys (SECRET: server only, added in Phase 6)
ANTHROPIC_API_KEY=

# Claude model used for visualizations
ANTHROPIC_MODEL=claude-sonnet-5-5

# The deployed address; http://localhost:3000 while developing
APP_URL=http://localhost:3000

# Largest video clip upload in MB
MAX_VIDEO_MB=50

# AI visualizations per person per day
AI_DAILY_LIMIT=30
